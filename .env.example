# Copy this file to .env and fill in the values (from Replit > Tools > Secrets)

# PostgreSQL connection string (local Postgres, or Replit's DATABASE_URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fb_ad_scanner

# Meta (Facebook) app credentials
META_APP_ID=
META_APP_SECRET=

# Meta system user token (used for scanning ad accounts)
META_SYSTEM_USER_TOKEN=

# Any long random string, used to sign session cookies
SESSION_SECRET=change-me

PORT=5000

# First password for the built-in super admins (renny@infinitymediala.com,
# hunbal.codeavenir@gmail.com). Only used while they have no password yet.
SUPER_ADMIN_INITIAL_PASSWORD=

# Email for team invites and password resets (Resend). Optional: without it,
# admins add users with a temporary password or copy an invite link instead.
RESEND_API_KEY=
EMAIL_FROM=Meta Ads QA <noreply@infinitymediala.com>

# Public base URL for links in emails (falls back to the request's host)
APP_URL=
